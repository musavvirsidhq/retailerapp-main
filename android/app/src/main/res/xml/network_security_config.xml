  Release builds talk to the backend over HTTPS only (Cycle 5 section 2). Debug builds replace
  this file with src/debug/res/xml/network_security_config.xml, which still allows the plain-HTTP
  test server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
