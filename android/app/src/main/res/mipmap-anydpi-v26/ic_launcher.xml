<?xml version="1.0" encoding="utf-8"?>
<!-- Cycle 5 adaptive launcher icon: the logo sits inside the safe zone on a solid background,
     so round/squircle launchers no longer crop it. The monochrome layer is used for Android 13
     themed icons. Replace drawable-*/ic_launcher_logo.png when the design asset arrives. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
